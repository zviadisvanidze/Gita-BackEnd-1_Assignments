<%- include('partials/header', { title: 'ახალი ხარჯის დამატება' }) %>

<h1>ახალი ხარჯის დამატება</h1>

<% if (errors.length > 0) { %>
    <ul class="error-list">
        <% errors.forEach(err => { %>
            <li><%= err %></li>
        <% }) %>
    </ul>
<% } %>

<form method="POST" action="/expenses" class="expense-form">
    <label for="title">სათაური</label>
    <input type="text" id="title" name="title" value="<%= values.title %>">

    <label for="amount">თანხა</label>
    <input type="number" id="amount" name="amount" step="0.01" min="0.01" value="<%= values.amount %>">

    <label for="category">კატეგორია</label>
    <input type="text" id="category" name="category" value="<%= values.category %>">

    <div class="form-actions">
        <button type="submit">დამატება</button>
        <a href="/" class="cancel-link">გაუქმება</a>
    </div>
</form>

<%- include('partials/footer') %>
